# Copy this file to ".env" and fill in the values. ".env" is private and is never committed.
# This file only lists the settings, with placeholders. Do not put real secrets in it.

# ---- Server ----
PORT=5000
# "development" on your PC, "production" when deployed.
NODE_ENV=development
# Where the website runs. Several addresses can be separated by commas.
FRONTEND_URL=http://localhost:5173

# ---- Database (Supabase) ----
# Supabase -> Connect. Use the Transaction pooler (port 6543) here...
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# ...and the Session pooler (port 5432) here. Used for migrations.
# If the password contains special characters, URL-encode them (for example % becomes %25).
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Login security ----
# A long random string (64+ characters). Anyone who knows it can pretend to be any user.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN_DAYS=7
BCRYPT_ROUNDS=12
# "lax" when the site and API share a domain or the API is proxied through the site.
# "none" only when they are on different domains (for example vercel.app and onrender.com).
COOKIE_SAME_SITE=lax

# ---- Owner account (created by `npm run db:seed`) ----
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHOOSE_A_STRONG_PASSWORD

# ---- Card payments (PayHere) ----
# simulated = fake gateway for development (default on your PC, never allowed in production)
# sandbox   = PayHere test environment
# live      = real payments
# disabled  = no card payments, customers use cash on delivery or WhatsApp (default in production)
PAYHERE_MODE=simulated
# Needed for sandbox and live. From PayHere -> Settings -> Domains & Credentials.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# The public address PayHere can reach this API on, for example https://flower-api.onrender.com
# (on your own PC use a tunnel such as ngrok).
PUBLIC_API_URL=
# A card order unpaid after this many minutes is cancelled and its stock goes back on sale.
PAYMENT_WINDOW_MINUTES=30
