// Ceylon Petals database schema.
//
// Built from the frontend types (frontend/src/types) and the mock database collections
// (frontend/src/services/mockDb.ts), so the API can return the same shapes the pages already use.
//
// Conventions
//  - Money is stored as whole Sri Lankan rupees (Int). There are no cents to track.
//  - Ids are UUIDs, except lookup tables that are naturally keyed (Occasion.slug).
//  - Order and inquiry numbers come from database sequences: CP-1050, INQ-104 ...
//  - Phone numbers are digits in international format without "+", e.g. 94771234567.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  CUSTOMER
  OWNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
  WHATSAPP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// The frontend uses the lower-case versions: morning, afternoon, evening, midnight.
enum DeliverySlot {
  MORNING
  AFTERNOON
  EVENING
  MIDNIGHT
}

enum InquiryType {
  WEDDING
  BULK
  CORPORATE
  CUSTOM
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CONFIRMED
  CLOSED
}

enum PromoType {
  PERCENT
  FIXED
}

// ---------------------------------------------------------------- people

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  // Always stored lower-case so sign-in is not case sensitive.
  email        String   @unique
  phone        String
  passwordHash String
  // Only ever set to OWNER by the seed script or by hand. The register endpoint cannot do it.
  role         Role     @default(CUSTOMER)
  // Bumped on password change or "sign out everywhere". Login tokens carry this number and
  // stop working as soon as it no longer matches.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  orders         Order[]
  passwordResets PasswordReset[]
}

// A one-time link the owner creates for a customer who forgot their password (the shop sends no
// email, so the owner passes the link on, for example on WhatsApp). Only a SHA-256 hash of the
// token is stored, so a copy of the database cannot be used to reset anyone's password.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  label         String
  recipientName String
  phone         String
  line1         String
  city          String
  district      String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- catalogue

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  imageUrl    String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  products Product[]
}

model Occasion {
  slug        String @id
  name        String
  description String @default("")
  sortOrder   Int    @default(0)

  products Product[]
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique
  name              String
  categoryId        String   @db.Uuid
  shortDescription  String
  description       String
  // Regular price. discountPrice, when set, must be lower and is what customers pay.
  price             Int
  discountPrice     Int?
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isFeatured        Boolean  @default(false)
  // Hidden products stay in the admin but never appear in the shop.
  isActive          Boolean  @default(true)
  sameDay           Boolean  @default(true)
  badge             String?
  // "What's included" bullets, flower types, colours and collection tags (tea, choc, low-light ...).
  details           String[]
  flowerTypes       String[]
  colours           String[]
  tags              String[]
  // Extra facts for plants, e.g. {"Light": "Bright, indirect", "Pet safe": "Yes"}.
  attributes        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  occasions  Occasion[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  url       String
  // Cloudinary id, so the file can be deleted when the photo is removed.
  publicId  String?
  // 0 is the main photo.
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// Photos the owner uploads when Cloudinary is not set up. The browser shrinks each photo first
// (WebP, at most 1600px), so they stay small. Served at /api/images/<id>.
model StoredImage {
  id        String   @id @default(uuid()) @db.Uuid
  mime      String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- orders

model Order {
  id            String  @id @default(uuid()) @db.Uuid
  // Display number is "CP-" + number. The sequence is restarted at 1050 in the first migration.
  number        Int     @unique @default(autoincrement())
  // Null for guest checkout.
  userId        String? @db.Uuid
  customerName  String
  customerPhone String
  customerEmail String?
  isOverseas    Boolean @default(false)

  recipientName  String
  recipientPhone String
  address        String
  area           String
  district       String
  // Date only (no time zone problems): the day the flowers must arrive.
  deliveryDate   DateTime     @db.Date
  deliverySlot   DeliverySlot
  cardMessage    String?
  deliveryNotes  String?

  subtotal    Int
  deliveryFee Int     @default(0)
  discount    Int     @default(0)
  promoCode   String?
  total       Int

  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  // PayHere payment id, saved when their callback confirms a card payment.
  paymentReference String?
  paidAt           DateTime?
  status           OrderStatus   @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([deliveryDate])
  @@index([createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  // Kept as null if the product is deleted later; the snapshot below still describes the line.
  productId String? @db.Uuid
  // Snapshot of the product at the time of the order, so old orders never change.
  name      String
  slug      String?
  imageUrl  String?
  unitPrice Int
  quantity  Int
  // Free text for custom items, e.g. the parts of a built hamper.
  options   String?
  // Keeps the lines in the order the customer had them in the cart (0 is first).
  position  Int     @default(0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------- inquiries

model Inquiry {
  id         String        @id @default(uuid()) @db.Uuid
  // Display reference is "INQ-" + number.
  number     Int           @unique @default(autoincrement())
  type       InquiryType
  name       String
  email      String
  phone      String
  eventDate  DateTime?     @db.Date
  location   String?
  budget     String?
  quantity   String?
  details    String
  // Other answers from the form as label/value pairs.
  extra      Json?
  status     InquiryStatus @default(NEW)
  ownerNotes String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------- customer reviews

// Customer reviews shown on the home page. The owner adds, edits, hides and orders them in the admin.
model Review {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  location    String   @default("")
  rating      Int
  message     String
  // e.g. "Ordered 'Nuwara Eliya Crimson Empress'". Empty = not shown.
  orderedItem String   @default("")
  // Hidden reviews stay in the admin but never appear on the website.
  isPublished Boolean  @default(true)
  // Lower numbers show first.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

// ---------------------------------------------------------------- shop settings

model DeliveryZone {
  id       String  @id @default(uuid()) @db.Uuid
  district String  @unique
  fee      Int
  sameDay  Boolean @default(false)
  active   Boolean @default(true)
}

model PromoCode {
  id          String    @id @default(uuid()) @db.Uuid
  // Always stored upper-case.
  code        String    @unique
  type        PromoType
  value       Int
  minOrder    Int       @default(0)
  active      Boolean   @default(true)
  description String    @default("")
  createdAt   DateTime  @default(now())
}

// One row only (id is always 1; the migration adds a check for that).
model ShopSettings {
  id               Int      @id @default(1)
  shopName         String
  tagline          String   @default("")
  // International format without "+", used for wa.me links.
  whatsappNumber   String
  phone            String   @default("")
  email            String   @default("")
  address          String   @default("")
  openingHours     String   @default("")
  // 24-hour "HH:MM". Same-day orders must be placed before this time.
  sameDayCutoff    String   @default("14:00")
  acceptingOrders  Boolean  @default(true)
  freeDeliveryOver Int      @default(0)
  // Shown in the bar at the top of every page. Empty = the automatic delivery message.
  announcement     String   @default("")
  // Social profiles shown in the footer. Empty = not shown.
  instagramUrl     String   @default("")
  facebookUrl      String   @default("")
  tiktokUrl        String   @default("")
  updatedAt        DateTime @updatedAt
}
