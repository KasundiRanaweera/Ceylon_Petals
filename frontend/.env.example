# Development: leave empty. The browser calls /api and Vite forwards it to the backend (DEV_API_TARGET).
# Production: the backend's address, without /api. For example https://ceylon-petals-api.onrender.com
VITE_API_URL=

# Development only: where Vite forwards /api (the backend's PORT).
DEV_API_TARGET=http://localhost:5000
